# Local Compose defaults. Use dedicated TLS database credentials in production.
DATABASE_URL=postgresql://palonex@127.0.0.1:5433/palonex
DATABASE_POOL_MAX=3
APP_ORIGIN=http://localhost:3000
# Generate independent random secrets with: openssl rand -hex 32
ENQUIRY_SIGNING_SECRET=
# Optional. Set only when your reverse proxy overwrites this header with a single IP.
ENQUIRY_TRUSTED_IP_HEADER=
# Email worker. Set all four to enable scheduled delivery.
CRON_SECRET=
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=
# Apply at least daily using npm run db:prune.
ENQUIRY_RETENTION_DAYS=365

# Independent secret for administrator sessions. Use openssl rand -hex 32.
BETTER_AUTH_SECRET=

# Public account authentication. Generate an independent 32+ character secret.
PUBLIC_AUTH_SECRET=
# Verified Resend sender for verification and password recovery.
IDENTITY_EMAIL_FROM=
