{
  "name": "palonex-hq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --conditions=react-server --test tests/unit/*.test.ts",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local db/migrate.ts",
    "db:prune": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local db/prune.ts",
    "test:integration": "node --conditions=react-server --test tests/integration/*.test.ts",
    "admin:staff": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local db/admin.ts",
    "db:status": "npm run db:migrate -- status",
    "deploy:check": "node --conditions=react-server db/ops/check-config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "better-auth": "^1.7.28",
    "kysely": "^0.29.9",
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.3"
  }
}
